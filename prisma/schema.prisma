generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Experiment {
  id           String   @id @default(uuid())
  title        String
  hypothesis   String?
  rowCount     Int
  cardinality  Int
  distribution String
  query        String
  createdAt    DateTime @default(now())
}
